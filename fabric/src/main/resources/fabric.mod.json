{
  "schemaVersion": 1,
  "id": "tickweave",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/kltyton/TickWeave",
    "issues": "https://github.com/kltyton/TickWeave/issues",
    "homepage": "https://github.com/kltyton/TickWeave"
  },
  "license": "${license}",
  "icon": "tickweave.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.axalotl.async.fabric.AsyncFabric"
    ]
  },
  "mixins": [
    "tickweave.collections.mixins.json",
    "tickweave.common.mixins.json",
    "tickweave.fabric.mixins.json"
  ],
  "accessWidener": "async.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric": "*",
    "minecraft": "1.20.1",
    "java": ">=17"
  },
  "breaks": {
    "moonrise": "*"
  },
  "custom": {
    "lithium:options": {
      "mixin.entity.collisions.unpushable_cramming": false
    }
  }
}
